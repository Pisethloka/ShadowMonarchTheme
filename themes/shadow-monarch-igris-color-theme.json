  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#10B981",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & Primary Text",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.block",
        "meta.parameter.type.variable"
      ],
      "settings": {
        "foreground": "#E2E8F0"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "storage.type",
        "storage.modifier",
        "keyword.other.import",
        "keyword.other.export"
      ],
      "settings": {
        "foreground": "#F43F5E"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E11D48"
      }
    },
    {
      "name": "Punctuation & Delimiters",

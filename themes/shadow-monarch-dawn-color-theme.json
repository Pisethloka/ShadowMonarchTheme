    },
    {
      "name": "React Hooks",
      "scope": [
        "support.function.react",
        "support.function.builtin.react",
        "entity.name.function.react",
        "meta.function-call.react"
      ],
      "settings": {
        "foreground": "#92400E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#92400E",
        "fontStyle": "italic"

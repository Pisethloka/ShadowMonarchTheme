  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#047857",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python Docstrings",
      "scope": [
        "string.quoted.docstring.multi.python"
      ],
      "settings": {
        "foreground": "#047857",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & Primary Text",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.block"
      ],
      "settings": {
        "foreground": "#2E1065"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter.type.variable",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#4C1D95"
      }
    },
    {
      "name": "Constants & Readonly Variables",
      "scope": [
        "variable.other.constant",
        "variable.other.readonly"
      ],
      "settings": {
        "foreground": "#4C1D95",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Flow Keywords",
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.repeat",
        "keyword.control.flow",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#5B21B6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Declaration Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#6D28D9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.comparison",
        "keyword.operator.arithmetic",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#4338CA"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.delimiter",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.block"
      ],
      "settings": {
        "foreground": "#6D28D9"
      }
    },
    {
      "name": "Function Declarations",
      "scope": [
        "entity.name.function",
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#B45309",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Calls & Invocations",
      "scope": [
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#92400E"
      }
    },
    {
      "name": "Built-in & Library Functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.console"
      ],
      "settings": {
        "foreground": "#0369A1"
      }
    },
    {
      "name": "React Hooks",
      "scope": [
        "support.function.react",
        "support.function.builtin.react",
        "entity.name.function.react"
      ],
      "settings": {
        "foreground": "#B45309",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators & Annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#B45309",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.type.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#5B21B6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#0284C7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Enums & Structs",
      "scope": [
        "entity.name.type.enum",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#4338CA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "General Types",

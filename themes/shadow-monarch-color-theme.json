  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#10B981",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python Docstrings",
      "scope": [
        "string.quoted.docstring.multi.python"
      ],
      "settings": {
        "foreground": "#10B981",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables & Primary Text",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.block"
      ],
      "settings": {
        "foreground": "#E2D9F3"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter.type.variable",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#CBD5E1"
      }
    },
    {
      "name": "Constants & Readonly Variables",
      "scope": [
        "variable.other.constant",
        "variable.other.readonly"
      ],
      "settings": {
        "foreground": "#C4B5FD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Flow Keywords",
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.repeat",
        "keyword.control.flow",
        "keyword.control.trycatch",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Declaration Keywords & Storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#A78BFA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.comparison",
        "keyword.operator.arithmetic",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#818CF8"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "meta.delimiter",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.block"
      ],
      "settings": {
        "foreground": "#C4B5FD"
      }
    },
    {
      "name": "Function Declarations",
      "scope": [
        "entity.name.function",
        "entity.name.function.constructor"
      ],
      "settings": {
        "foreground": "#FBBF24",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Calls & Invocations",
      "scope": [
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#F59E0B"
      }
    },
    {
      "name": "Built-in & Library Functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.console"
      ],
      "settings": {
        "foreground": "#06B6D4"
      }
    },
    {
      "name": "React Hooks",
      "scope": [
        "support.function.react",
        "support.function.builtin.react",
        "entity.name.function.react"
      ],
      "settings": {
        "foreground": "#FBBF24",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators & Annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#FBBF24",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.type.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#8B5CF6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.type-parameter"
      ],
      "settings": {
        "foreground": "#22D3EE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Enums & Structs",
      "scope": [
        "entity.name.type.enum",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#818CF8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "General Types",
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#8B5CF6"
      }
    },
    {
      "name": "Strings & Quoted Text",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Template Literals",
      "scope": [
        "string.template"
      ],
      "settings": {
        "foreground": "#60A5FA"
      }
    },
    {
      "name": "Template Literal Expressions",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#818CF8"
      }
    },
    {
      "name": "Regular Expressions (Regex)",
      "scope": [
        "string.regexp",
        "string.regexp.character-class",
        "punctuation.definition.string.regexp"
      ],
      "settings": {
        "foreground": "#2DD4BF"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F43F5E"
      }
    },
    {
      "name": "Booleans & Language Constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#FB7185",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JSON Keys",
      "scope": [
        "support.type.property-name.json",
        "meta.object-key.json",
        "meta.structure.dictionary.key.json"
      ],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "name": "JSON Values",
      "scope": [
        "string.quoted.double.json",
        "string.quoted.single.json"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "HTML / XML Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "HTML / XML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "name": "HTML Attribute Values",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "JSX Native DOM Tags",
      "scope": [
        "entity.name.tag.jsx",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#C084FC"
      }
    },
    {
      "name": "JSX Custom Components",
      "scope": [
        "support.class.component.jsx",
        "support.class.component.tsx"
      ],
      "settings": {
